generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  staff
}

model Organization {
  id          Int @id @default(autoincrement())

  companyName String

  industry    String

  users       User[]

  departments Department[]

  branches    Branch[]

  attendances Attendance[]

  staffAllocations StaffAllocation[]

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt
}

model User {
  id             Int @id @default(autoincrement())

  organizationId Int

  organization   Organization @relation(fields: [organizationId], references: [id])

  departmentId   Int?

  department     Department? @relation(fields: [departmentId], references: [id])

  branchId       Int?

  branch         Branch? @relation(fields: [branchId], references: [id])

  staffId        String? @unique

  name           String

  email          String @unique

  phone          String?

  password       String

  role           Role @default(staff)

  joinedOn       DateTime

  // OPTIONAL OVERRIDES
  shiftStart     String?

  shiftEnd       String?

  salary         Float?

  overtimeEnabled Boolean?

  overtimeHourlyRate Float?

  overtimeGraceMins Int?

  // RELATIONS
  attendances      Attendance[]

  staffAllocations StaffAllocation[]

  createdAt      DateTime @default(now())

  updatedAt      DateTime @updatedAt
}

model Department {
  id                  Int @id @default(autoincrement())

  organizationId      Int

  name                String

  // DEFAULT RULES
  shiftStart          String

  shiftEnd            String

  overtimeEnabled     Boolean @default(false)

  overtimeGraceMins   Int @default(15)

  overtimeHourlyRate  Float?

  defaultSalary       Float

  organization        Organization @relation(fields: [organizationId], references: [id])

  users               User[]

  createdAt           DateTime @default(now())

  updatedAt           DateTime @updatedAt
}

model Branch {
  id               Int @id @default(autoincrement())

  organizationId   Int

  name             String

  latitude         Float

  longitude        Float

  allowedRadius    Float @default(100)

  organization     Organization @relation(fields: [organizationId], references: [id])

  users            User[]

  attendances      Attendance[]

  staffAllocations StaffAllocation[]

  createdAt        DateTime @default(now())

  updatedAt        DateTime @updatedAt
}

model Attendance {
  id                 Int @id @default(autoincrement())

  userId             Int

  user               User @relation(fields: [userId], references: [id])

  organizationId     Int

  organization       Organization @relation(fields: [organizationId], references: [id])

  branchId           Int

  branch             Branch @relation(fields: [branchId], references: [id])

  checkInTime        DateTime?

  checkOutTime       DateTime?

  checkInLatitude    Float?

  checkInLongitude   Float?

  checkOutLatitude   Float?

  checkOutLongitude  Float?

  status             String @default("present")

  totalWorkHours     Float?

  createdAt          DateTime @default(now())

  updatedAt          DateTime @updatedAt
}

model StaffAllocation {
  id               Int @id @default(autoincrement())

  userId           Int

  user             User @relation(fields: [userId], references: [id])

  organizationId   Int

  organization     Organization @relation(fields: [organizationId], references: [id])

  branchId         Int

  branch           Branch @relation(fields: [branchId], references: [id])

  floorName        String

  assignedBy       Int

  assignedAt       DateTime @default(now())

  checkedOutAt     DateTime?

  isActive         Boolean @default(true)

  createdAt        DateTime @default(now())

  updatedAt        DateTime @updatedAt
}