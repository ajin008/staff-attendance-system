generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               Int               @id @default(autoincrement())
  companyName      String
  industry         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendances      Attendance[]
  branches         Branch[]
  departments      Department[]
  floors           Floor[]
  leaveRequests    LeaveRequest[]
  notifications    Notification[]
  payrolls         Payroll[]
  staffAllocations StaffAllocation[]
  users            User[]
}

model User {
  id                    Int                @id @default(autoincrement())
  organizationId        Int
  departmentId          Int?
  branchId              Int?
  staffId               String?            @unique
  name                  String
  email                 String             @unique
  phone                 String?
  password              String
  role                  Role               @default(staff)
  joinedOn              DateTime
  shiftStart            String?
  shiftEnd              String?
  salary                Float?
  overtimeEnabled       Boolean?
  overtimeHourlyRate    Float?
  overtimeGraceMins     Int?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  isActive              Boolean            @default(true)
  attendances           Attendance[]
  leaveRequests         LeaveRequest[]
  createdNotifications  Notification[]     @relation("CreatedNotifications")
  receivedNotifications Notification[]     @relation("TargetNotifications")
  notificationReads     NotificationRead[]
  payrolls              Payroll[]
  staffAllocations      StaffAllocation[]
  branch                Branch?            @relation(fields: [branchId], references: [id])
  department            Department?        @relation(fields: [departmentId], references: [id])
  organization          Organization       @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, phone])
}

model Department {
  id                 Int          @id @default(autoincrement())
  organizationId     Int
  name               String
  shiftStart         String
  shiftEnd           String
  overtimeEnabled    Boolean      @default(false)
  overtimeGraceMins  Int          @default(15)
  overtimeHourlyRate Float?
  defaultSalary      Float
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  weeklyOffDays      String[]
  isActive           Boolean      @default(true)
  organization       Organization @relation(fields: [organizationId], references: [id])
  users              User[]
}

model Branch {
  id               Int               @id @default(autoincrement())
  organizationId   Int
  name             String
  latitude         Float
  longitude        Float
  allowedRadius    Float             @default(100)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendances      Attendance[]
  organization     Organization      @relation(fields: [organizationId], references: [id])
  floors           Floor[]
  staffAllocations StaffAllocation[]
  users            User[]
}

model Attendance {
  id                Int          @id @default(autoincrement())
  userId            Int
  organizationId    Int
  branchId          Int
  checkInTime       DateTime?
  checkOutTime      DateTime?
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  attendanceStatus  String       @default("present")
  earlyExitMinutes  Int          @default(0)
  isEarlyExit       Boolean      @default(false)
  isHalfDay         Boolean      @default(false)
  isLate            Boolean      @default(false)
  isOvertime        Boolean      @default(false)
  lateMinutes       Int          @default(0)
  overtimeMinutes   Int          @default(0)
  shiftEnd          String?
  shiftStart        String?
  totalWorkMinutes  Int          @default(0)
  isAutoCheckout    Boolean      @default(false)
  branch            Branch       @relation(fields: [branchId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])
  user              User         @relation(fields: [userId], references: [id])
  @@index([userId, checkInTime])
}

model StaffAllocation {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  branchId       Int
  assignedBy     Int
  assignedAt     DateTime     @default(now())
  checkedOutAt   DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  floorId        Int
  branch         Branch       @relation(fields: [branchId], references: [id])
  floor          Floor        @relation(fields: [floorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model Floor {
  id               Int               @id @default(autoincrement())
  organizationId   Int
  branchId         Int
  name             String
  code             String?
  maxCapacity      Int
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  branch           Branch            @relation(fields: [branchId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  staffAllocations StaffAllocation[]
}

model LeaveRequest {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  leaveType      String
  reason         String?
  startDate      String
  endDate        String
  totalDays      Int
  status         String       @default("pending")
  approvedBy     Int?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model Payroll {
  id               Int          @id @default(autoincrement())
  userId           Int
  organizationId   Int
  payrollStartDate DateTime
  payrollEndDate   DateTime
  basicSalary      Float
  presentDays      Int
  absentDays       Int
  halfDays         Int
  overtimeMinutes  Int
  deductions       Float
  overtimePay      Float
  netSalary        Float
  pdfUrl           String?
  generatedAt      DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id])
  user             User         @relation(fields: [userId], references: [id])
}

model Notification {
  id             Int                @id @default(autoincrement())
  organizationId Int
  title          String
  message        String
  type           NotificationType
  targetUserId   Int?
  createdById    Int
  createdAt      DateTime           @default(now())
  expiresAt      DateTime?
  createdBy      User               @relation("CreatedNotifications", fields: [createdById], references: [id])
  organization   Organization       @relation(fields: [organizationId], references: [id])
  targetUser     User?              @relation("TargetNotifications", fields: [targetUserId], references: [id])
  reads          NotificationRead[]

  @@index([organizationId])
  @@index([targetUserId])
  @@index([expiresAt])
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  notificationId Int
  userId         Int
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
}

enum Role {
  admin
  staff
}

enum NotificationType {
  ALL
  PERSONAL
}
